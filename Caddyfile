# Ortak guvenlik basliklari
(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
		-Server
	}
}

# SPA statik dosyalari. Vite'in hash'li /assets/* dosyalari hic degismez ->
# 1 yil onbellek. index.html ve diger dosyalar her seferinde dogrulanir
# (no-cache = ETag ile kontrol et); boylece deploy sonrasi ziyaretciler eski
# surumu gormez (2026-10-08'de tarayicinin eski index.html'i tuttugu goruldu).
(spa) {
	@immutable path /assets/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"
	@revalidate not path /assets/*
	header @revalidate Cache-Control "no-cache"
	try_files {path} /index.html
	file_server
}

{$DOMAIN} www.{$DOMAIN} {
	encode zstd gzip
	import security_headers

	handle /api/* {
		reverse_proxy backend:8000
	}

	handle /uploads/* {
		header Cache-Control "public, max-age=604800"
		reverse_proxy backend:8000
	}

	handle {
		root * /srv/public
		import spa
	}
}

{$APP_DOMAIN} {
	encode zstd gzip
	import security_headers

	handle /api/* {
		reverse_proxy backend:8000
	}

	handle /uploads/* {
		header Cache-Control "public, max-age=604800"
		reverse_proxy backend:8000
	}

	handle {
		root * /srv/app
		import spa
	}
}

{$API_DOMAIN} {
	encode zstd gzip
	import security_headers
	reverse_proxy backend:8000
}
